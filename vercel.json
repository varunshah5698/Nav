{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/horizon-homes",
      "destination": "/horizon-homes/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/analyst",
      "destination": "https://nav-y35d.onrender.com/api/analyst"
    },
    {
      "source": "/api/analyst/:path*",
      "destination": "https://nav-y35d.onrender.com/api/analyst/:path*"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/register",
      "destination": "/index.html"
    }
  ]
}
