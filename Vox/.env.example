# VoxSafe environment template.
# Copy to .env (never commit it) and fill in real values.
# Pydantic reads .env at the repository root and backend/.env, in that order.

# --- Runtime ---------------------------------------------------------------
# development | staging | production. Production refuses to start without SECRET_KEY.
APP_ENV=development

# 32+ random bytes. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Data ------------------------------------------------------------------
# SQLite is the documented single-process development substitute.
DATABASE_URL=sqlite:///backend/var/voxsafe.db
# PostgreSQL 16 (production / docker compose):
# DATABASE_URL=postgresql+psycopg://voxsafe:voxsafe@localhost:5432/voxsafe

# Local filesystem storage stands in for S3/MinIO in development.
MEDIA_ROOT=backend/var/media

# --- Intake and retention --------------------------------------------------
MAX_UPLOAD_MB=50
AUDIO_RETENTION_DAYS=90

# --- Policy ----------------------------------------------------------------
POLICY_PATH=policy/policies/v1.yaml
# Comma-separated gated capabilities. Empty means credibility (R5) is off.
ENABLED_CAPABILITIES=

# --- Authentication --------------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# --- Web -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Optional first-run bootstrap (development only) -----------------------
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=VoxSafe Agent

# --- Frontend (Vite) -------------------------------------------------------
# VITE_API_BASE=/v1
