VITE_API_URL=
# Convex cloud: VITE_CONVEX_URL is public; the deploy key lives only in .env.local
VITE_CONVEX_URL=
CONVEX_DEPLOYMENT=
# Convex Auth (set on the deployment with `npx convex env set`, not here):
#   AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET  — Google OAuth client
#   SITE_URL                            — app origin, e.g. http://localhost:5173
DATABASE_URL=postgresql://rg:rg@localhost:5432/researchgraph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
QDRANT_URL=http://localhost:6333
JWT_SECRET=change-me
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# AI Analyst (Groq) — server-side only, never expose in the Vite bundle
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
